{
  "presets": [
    [
      "@babel/preset-env",
      {
        "modules": false,
        "bugfixes": true,
        "targets": {
          "browsers": [
            "last 2 versions",
            "> 0.5%",
            "not dead",
            "not ie 11"
          ]
        },
        "useBuiltIns": "entry",
        "corejs": {
          "version": 3,
          "proposals": true
        }
      }
    ]
  ]
}
