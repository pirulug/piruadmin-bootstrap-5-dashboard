{
  "homepage": "https://pirulug.github.io/piruadmin-bootstrap-5-dashboard",
  "name": "piruadmin-bootstrap-5-dashboard",
  "version": "2.5.0",
  "description": "Admin dashboard bootstrap 5",
  "keywords": [
    "template",
    "css",
    "sass",
    "html",
    "theme",
    "front-end",
    "ui kit",
    "web"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production rspack build --config rspack.config.js",
    "dev": "cross-env NODE_ENV=development rspack build --config rspack.config.js",
    "dev:plugins": "cross-env NODE_ENV=development PLUGINS=true rspack build --config rspack.config.js --env plugins",
    "watch": "rspack build --config rspack.config.js --watch",
    "start": "rspack serve --config rspack.config.js",
    "start:plugins": "cross-env PLUGINS=true rspack serve --config rspack.config.js --env plugins",
    "prepublishOnly": "cross-env NODE_ENV=production rspack build --config rspack.config.js",
    "deploy": "gh-pages -d dist"
  },
  "author": "Pirulug",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pirulug/piruadmin-bootstrap-5-dashboard.git"
  },
  "devDependencies": {
    "@rspack/cli": "^2.3.4",
    "@rspack/core": "^2.3.4",
    "@rspack/dev-server": "^2.2.2",
    "cross-env": "10.1.0",
    "css-loader": "7.1.5",
    "gh-pages": "^6.3.0",
    "html-webpack-plugin": "^5.6.8",
    "pirulug-delete-empty-files-webpack-plugin": "^0.0.3",
    "pirulug-prettify-webpack-plugin": "^0.1.1",
    "pirulug-pug-loader": "^0.0.18",
    "postcss": "^8.5.33",
    "postcss-loader": "8.2.2",
    "postcss-preset-env": "^11.6.3",
    "pug": "^3.0.4",
    "sass": "^1.108.2",
    "sass-loader": "17.1.1"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-code": "^5.3.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@justinribeiro/lite-youtube": "^1.9.0",
    "@popperjs/core": "2.11.8",
    "@yaireo/tagify": "^4.39.0",
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.6.2",
    "feather-icons": "4.29.2",
    "flag-icons": "^7.6.0",
    "flatpickr": "4.6.13",
    "jsvectormap": "1.7.0",
    "simplebar": "6.3.3",
    "simplemde": "^1.11.2",
    "sweetalert2": "^11.26.26",
    "toastify-js": "^1.12.0"
  }
}
