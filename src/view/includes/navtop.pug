nav.navtop
  a.sidebar-toggle.js-sidebar-toggle
    i.hamburger.align-self-center

  form.d-none.d-sm-inline-block.ms-3
    .input-group.input-group-navbar
      input.form-control(type="text" placeholder="Search..." aria-label="Search")
      button.btn(type="button")
        i.bi.bi-search

  .navbar-collapse.collapse
    ul.navbar-nav.navbar-align
      
      li.nav-item
        a#fullscreen-btn.nav-icon(href="#" title="Full Screen")
          i.bi.bi-fullscreen

      li.nav-item.dropdown
        a#bd-theme.nav-icon.dropdown-toggle(type="button" aria-expanded="false" data-bs-toggle="dropdown" aria-label="Toggle theme (auto)")
          span#bd-theme-icon.theme-icon-active
          span#bd-theme-text.visually-hidden Toggle theme
        ul.dropdown-menu.dropdown-menu-end(aria-labelledby="bd-theme-text")
          li
            button.dropdown-item.d-flex.align-items-center(type="button" data-bs-theme-value="light" aria-pressed="false")
              span.theme-icon-active.opacity-50.me-2(data-icon="sun")
              | Light
          li
            button.dropdown-item.d-flex.align-items-center(type="button" data-bs-theme-value="dark" aria-pressed="false")
              span.theme-icon-active.opacity-50.me-2(data-icon="moon")
              | Dark
          li
            button.dropdown-item.d-flex.align-items-center(type="button" data-bs-theme-value="auto" aria-pressed="true")
              span.theme-icon-active.opacity-50.me-2(data-icon="auto")
              | Auto

