extends ../../layouts/dashboard

append config
  - pageName = 'Alerts'
  - pageUrl = 'ui/alerts'

block styles
  link(rel="stylesheet", href=assets + "plugins/prismjs/prismjs.css")

block content
  .row.g-4
    // Basic Alerts
    .col-lg-6
      .card.h-100
        .card-body
          h5.card-title Basic Alerts
          p.text-muted Standard Bootstrap feedback messages using <code>.alert-{color}</code>.
          .py-3
            .alert.alert-primary(role='alert') A simple primary alert—check it out!
            .alert.alert-secondary(role='alert') A simple secondary alert—check it out!
            .alert.alert-success(role='alert') A simple success alert—check it out!
            .alert.alert-danger(role='alert') A simple danger alert—check it out!
          .text-center
            button.btn.btn-sm.btn-outline-secondary(type='button' data-bs-toggle='collapse' data-bs-target='#collapseBasic' aria-expanded='false')
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseBasic.mt-3
            .demo-code-preview(data-label='HTML EXAMPLE')
              button.copy-btn(type='button') Copy
              pre.language-html
                code.language-html.
                  &lt;div class="alert alert-primary" role="alert"&gt;
                    Basic alert message
                  &lt;/div&gt;

    // Alerts with Action
    .col-lg-6
      .card.h-100
        .card-body
          h5.card-title Alerts with Action
          p.text-muted Include buttons or links for immediate user interaction.
          .py-3
            .alert.alert-info.alert-media.align-items-center(role='alert')
              .alert-icon
                i.bi.bi-info-circle
              .alert-body
                .d-flex.justify-content-between.align-items-center
                  span Your profile is 80% complete.
                  a.btn.btn-sm.btn-info.text-white.ms-2(href='#') Complete now
            .alert.alert-warning.alert-media.align-items-center(role='alert')
              .alert-icon
                i.bi.bi-exclamation-triangle
              .alert-body
                .d-flex.justify-content-between.align-items-center
                  span Subscription ending soon.
                  button.btn.btn-sm.btn-warning(type='button') Renew
          .text-center
            button.btn.btn-sm.btn-outline-secondary(type='button' data-bs-toggle='collapse' data-bs-target='#collapseAction' aria-expanded='false')
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseAction.mt-3
            .demo-code-preview(data-label='HTML EXAMPLE')
              button.copy-btn(type='button') Copy
              pre.language-html
                code.language-html.
                  &lt;div class="alert alert-info alert-media align-items-center" role="alert"&gt;
                    &lt;div class="alert-body d-flex justify-content-between"&gt;
                      &lt;span&gt;Message&lt;/span&gt;
                      &lt;button class="btn btn-sm btn-info"&gt;Action&lt;/button&gt;
                    &lt;/div&gt;
                  &lt;/div&gt;

    // Dismissible Alerts
    .col-lg-6
      .card.h-100
        .card-body
          h5.card-title Dismissible Alerts
          p.text-muted Enable users to dismiss alerts with <code>.alert-dismissible</code>.
          .py-3
            .alert.alert-success.alert-dismissible.fade.show(role='alert')
              strong Success! 
              | This message can be dismissed.
              button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')
            .alert.alert-danger.alert-media.alert-dismissible.fade.show(role='alert')
              .alert-icon
                i.bi.bi-x-circle
              .alert-body
                strong Error! 
                | Please check your input fields.
              button.btn-close(type='button' data-bs-dismiss='alert' aria-label='Close')
          .text-center
            button.btn.btn-sm.btn-outline-secondary(type='button' data-bs-toggle='collapse' data-bs-target='#collapseDismiss' aria-expanded='false')
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseDismiss.mt-3
            .demo-code-preview(data-label='HTML EXAMPLE')
              button.copy-btn(type='button') Copy
              pre.language-html
                code.language-html.
                  &lt;div class="alert alert-success alert-dismissible fade show" role="alert"&gt;
                    Message
                    &lt;button class="btn-close" data-bs-dismiss="alert"&gt;&lt;/button&gt;
                  &lt;/div&gt;

    // Alert with Description
    .col-lg-6
      .card.h-100
        .card-body
          h5.card-title Alert with Description
          p.text-muted Use headings and paragraphs for more detailed messages.
          .py-3
            .alert.alert-primary.alert-media(role='alert')
              .alert-icon
                i.bi.bi-star-fill.fs-4
              .alert-body
                h4.alert-heading Exclusive Offer!
                p.mb-0 Get 20% off on your next purchase. Use the code 
                  strong WELCOME20
                  |  at checkout.
            .alert.alert-secondary.alert-media(role='alert')
              .alert-icon
                i.bi.bi-gear-fill.fs-4
              .alert-body
                h4.alert-heading System Maintenance
                p.mb-0 Scheduled maintenance will occur on Saturday from 2:00 AM to 4:00 AM UTC.
          .text-center
            button.btn.btn-sm.btn-outline-secondary(type='button' data-bs-toggle='collapse' data-bs-target='#collapseDescription' aria-expanded='false')
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseDescription.mt-3
            .demo-code-preview(data-label='HTML EXAMPLE')
              button.copy-btn(type='button') Copy
              pre.language-html
                code.language-html.
                  &lt;div class="alert alert-primary" role="alert"&gt;
                    &lt;h4 class="alert-heading"&gt;Title&lt;/h4&gt;
                    &lt;p&gt;Description text goes here.&lt;/p&gt;
                  &lt;/div&gt;

    // Important Alerts
    .col-lg-6
      .card.h-100
        .card-body
          h5.card-title Important Alerts
          p.text-muted Use <code>.alert-important</code> for high-visibility solid background alerts.
          .py-3
            .alert.alert-important.alert-primary.alert-media(role='alert')
              .alert-icon
                i.bi.bi-lightning-fill
              .alert-body This is an important primary announcement!
            .alert.alert-important.alert-success.alert-media(role='alert')
              .alert-icon
                i.bi.bi-check-circle-fill
              .alert-body System updated successfully to version 2.4.0.
            .alert.alert-important.alert-danger.alert-media(role='alert')
              .alert-icon
                i.bi.bi-shield-fill-x
              .alert-body Security breach detected in unauthorized zone.
          .text-center
            button.btn.btn-sm.btn-outline-secondary(type='button' data-bs-toggle='collapse' data-bs-target='#collapseImportant' aria-expanded='false')
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseImportant.mt-3
            .demo-code-preview(data-label='HTML EXAMPLE')
              button.copy-btn(type='button') Copy
              pre.language-html
                code.language-html.
                  &lt;div class="alert alert-important alert-primary" role="alert"&gt;
                    Important announcement
                  &lt;/div&gt;

    // Minor Alerts
    .col-lg-6
      .card.h-100
        .card-body
          h5.card-title Minor Alerts
          p.text-muted Compact messages using <code>.alert-minor</code> for less intrusive feedback.
          .py-3
            .alert.alert-minor.alert-secondary.alert-media.align-items-center(role='alert')
              .alert-icon
                i.bi.bi-info-circle
              .alert-body Your session will expire in 5 minutes.
            .alert.alert-minor.alert-outline-info.alert-media.align-items-center(role='alert')
              .alert-icon
                i.bi.bi-lightbulb
              .alert-body New feature: Auto-save is now enabled.
            .alert.alert-minor.alert-success.alert-media.align-items-center(role='alert')
              .alert-icon
                i.bi.bi-check2
              .alert-body Changes synced.
          .text-center
            button.btn.btn-sm.btn-outline-secondary(type='button' data-bs-toggle='collapse' data-bs-target='#collapseMinor' aria-expanded='false')
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseMinor.mt-3
            .demo-code-preview(data-label='HTML EXAMPLE')
              button.copy-btn(type='button') Copy
              pre.language-html
                code.language-html.
                  &lt;div class="alert alert-minor alert-secondary" role="alert"&gt;
                    Minor feedback message
                  &lt;/div&gt;

block scripts
  script(src=assets + "plugins/prismjs/prismjs.js")
