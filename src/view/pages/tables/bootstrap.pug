extends ../../layouts/dashboard

append config
  - pageName = "Tables"
  - pageUrl = "tables/bootstrap"

block content
  .row
    // =====================================================
    // Basic table
    // =====================================================
    .col-lg-6
      .card.mb-3
        .card-body
          h2.card-title Basic table
          p.text-secondary
            | Basic tables use the
            code .table
            |  class for standard data display.

          .table-responsive
            table.table
              thead
                tr
                  th #
                  th Name
                  th Email
                  th Status
              tbody
                tr
                  td 1
                  td John Doe
                  td john@example.com
                  td Active
                tr
                  td 2
                  td Jane Smith
                  td jane@example.com
                  td Inactive

    // =====================================================
    // Striped table
    // =====================================================
    .col-lg-6
      .card.mb-3
        .card-body
          h2.card-title Striped rows
          p.text-secondary
            | Striped tables use
            code .table-striped
            |  to add zebra-striping to table rows.

          .table-responsive
            table.table.table-striped
              thead
                tr
                  th #
                  th Product
                  th Price
                  th Stock
              tbody
                tr
                  td 1
                  td MacBook Pro 16"
                  td $2,499
                  td In stock
                tr
                  td 2
                  td Magic Mouse 2
                  td $79
                  td Out of stock
                tr
                  td 3
                  td AirPods Max
                  td $549
                  td In stock

    // =====================================================
    // Striped Columns table
    // =====================================================
    .col-lg-6
      .card.mb-3
        .card-body
          h2.card-title Striped columns
          p.text-secondary
            | Use
            code .table-striped-columns
            |  to add zebra-striping to table columns.

          .table-responsive
            table.table.table-striped-columns
              thead
                tr
                  th Metric
                  th Q1 2026
                  th Q2 2026
                  th Q3 2026
              tbody
                tr
                  td Revenue
                  td $45,200
                  td $52,800
                  td $61,400
                tr
                  td Expenses
                  td $18,400
                  td $21,100
                  td $23,500
                tr
                  td Profit
                  td $26,800
                  td $31,700
                  td $37,900

    // =====================================================
    // Hover table
    // =====================================================
    .col-lg-6
      .card.mb-3
        .card-body
          h2.card-title Hover rows
          p.text-secondary
            | Hover tables use
            code .table-hover
            |  to highlight rows on mouse over.

          .table-responsive
            table.table.table-hover
              thead
                tr
                  th #
                  th User
                  th Role
                  th Status
              tbody
                tr
                  td 1
                  td Jane Doe
                  td Administrator
                  td
                    span.badge.bg-success Active
                tr
                  td 2
                  td Alex Smith
                  td Editor
                  td
                    span.badge.bg-primary Active
                tr
                  td 3
                  td Maria Garcia
                  td Standard User
                  td
                    span.badge.bg-warning Pending

    // =====================================================
    // Bordered table
    // =====================================================
    .col-lg-6
      .card.mb-3
        .card-body
          h2.card-title Bordered table
          p.text-secondary
            | Bordered tables use
            code .table-bordered
            |  to add borders on all sides of the table and cells.

          .table-responsive
            table.table.table-bordered
              thead
                tr
                  th #
                  th Order ID
                  th Date
                  th Total
              tbody
                tr
                  td 1
                  td #ORD-1023
                  td 2026-08-10
                  td $340.00
                tr
                  td 2
                  td #ORD-1024
                  td 2026-08-11
                  td $180.50
                tr
                  td 3
                  td #ORD-1025
                  td 2026-08-12
                  td $920.00

    // =====================================================
    // Borderless table
    // =====================================================
    .col-lg-6
      .card.mb-3
        .card-body
          h2.card-title Borderless table
          p.text-secondary
            | Add
            code .table-borderless
            |  for a table without any cell borders.

          .table-responsive
            table.table.table-borderless
              thead
                tr
                  th #
                  th Service
                  th Plan
                  th Billing
              tbody
                tr
                  td 1
                  td Cloud Hosting
                  td Enterprise
                  td Monthly
                tr
                  td 2
                  td SSL Certificate
                  td Wildcard
                  td Annual
                tr
                  td 3
                  td Dedicated IP
                  td Add-on
                  td Monthly

    // =====================================================
    // Table Group Dividers
    // =====================================================
    .col-lg-6
      .card.mb-3
        .card-body
          h2.card-title Table group dividers
          p.text-secondary
            | Add
            code .table-group-divider
            |  to
            code tbody
            |  to add a thicker border separator.

          .table-responsive
            table.table
              thead
                tr
                  th Region
                  th Direct Sales
                  th Online Sales
                  th Total
              tbody.table-group-divider
                tr
                  td North America
                  td $14,200
                  td $28,900
                  td $43,100
                tr
                  td Europe
                  td $9,800
                  td $19,400
                  td $29,200
                tr
                  td Latin America
                  td $6,500
                  td $12,300
                  td $18,800

    // =====================================================
    // Compact (Small) table
    // =====================================================
    .col-lg-6
      .card.mb-3
        .card-body
          h2.card-title Small table
          p.text-secondary
            | Compact tables use
            code .table-sm
            |  to cut cell padding in half.

          .table-responsive
            table.table.table-sm
              thead
                tr
                  th #
                  th File Name
                  th Size
                  th Format
              tbody
                tr
                  td 1
                  td annual_report_2026.pdf
                  td 1.2 MB
                  td PDF
                tr
                  td 2
                  td logo_vector.svg
                  td 48 KB
                  td SVG
                tr
                  td 3
                  td product_hero.webp
                  td 240 KB
                  td WEBP

    // =====================================================
    // Contextual Table Variants
    // =====================================================
    .col-lg-6
      .card.mb-3
        .card-body
          h2.card-title Contextual classes
          p.text-secondary
            | Use contextual classes like
            code .table-primary
            | ,
            code .table-success
            | ,
            code .table-danger
            |  on rows or cells.

          .table-responsive
            table.table
              thead
                tr
                  th Class
                  th Status
                  th Description
              tbody
                tr.table-primary
                  td
                    code .table-primary
                  td Normal
                  td Primary system notification
                tr.table-success
                  td
                    code .table-success
                  td Completed
                  td Transaction verified
                tr.table-warning
                  td
                    code .table-warning
                  td Warning
                  td Server disk usage threshold
                tr.table-danger
                  td
                    code .table-danger
                  td Error
                  td Connection timeout occurred

    // =====================================================
    // Table with Active Row
    // =====================================================
    .col-lg-6
      .card.mb-3
        .card-body
          h2.card-title Active row state
          p.text-secondary
            | Highlight a row using
            code .table-active
            |  to denote selection or active state.

          .table-responsive
            table.table
              thead
                tr
                  th #
                  th Server Name
                  th IP Address
                  th Ping
              tbody
                tr.table-active
                  td
                    i.bi.bi-check-circle-fill.text-primary.me-1
                    | 1
                  td
                    strong us-east-prod-01 (Active)
                  td 192.168.10.12
                  td 14 ms
                tr
                  td 2
                  td us-west-prod-02
                  td 192.168.20.15
                  td 42 ms
                tr
                  td 3
                  td eu-central-prod-01
                  td 192.168.30.22
                  td 98 ms

    // =====================================================
    // Vertical Alignment table
    // =====================================================
    .col-lg-12
      .card.mb-3
        .card-body
          h2.card-title Vertical alignment &amp; rich content
          p.text-secondary
            | Use
            code .align-middle
            |  to align cell contents vertically in table cells with avatars and action buttons.

          .table-responsive
            table.table.table-hover.align-middle
              thead
                tr
                  th.ps-2 Member
                  th Role
                  th Task Progress
                  th Performance
                  th.text-end.pe-3 Actions
              tbody
                tr
                  td.ps-2
                    .d-flex.align-items-center
                      .rounded-circle.bg-primary.text-white.d-flex.align-items-center.justify-content-center.me-2(style="width: 36px; height: 36px; font-weight: 600")
                        | JD
                      div
                        .fw-bold Jane Doe
                        .small.text-body-secondary jane.doe@example.com
                  td
                    span.badge.bg-primary-subtle.text-primary Lead Architect
                  td(style="min-width: 140px")
                    .d-flex.align-items-center.gap-2
                      .progress.flex-grow-1(style="height: 6px")
                        .progress-bar.bg-primary(role="progressbar" style="width: 85%" aria-valuenow="85" aria-valuemin="0" aria-valuemax="100")
                      span.small.fw-bold 85%
                  td
                    span.text-success
                      i.bi.bi-arrow-up-short
                      | +18.2%
                  td.text-end.pe-3
                    .d-flex.justify-content-end.gap-1
                      button.btn.btn-sm.btn-outline-primary(type="button" title="Edit")
                        i.bi.bi-pencil
                      button.btn.btn-sm.btn-outline-danger(type="button" title="Delete")
                        i.bi.bi-trash
                tr
                  td.ps-2
                    .d-flex.align-items-center
                      .rounded-circle.bg-success.text-white.d-flex.align-items-center.justify-content-center.me-2(style="width: 36px; height: 36px; font-weight: 600")
                        | AS
                      div
                        .fw-bold Alex Smith
                        .small.text-body-secondary alex.smith@example.com
                  td
                    span.badge.bg-info-subtle.text-info Senior Dev
                  td
                    .d-flex.align-items-center.gap-2
                      .progress.flex-grow-1(style="height: 6px")
                        .progress-bar.bg-success(role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100")
                      span.small.fw-bold 100%
                  td
                    span.text-success
                      i.bi.bi-arrow-up-short
                      | +24.5%
                  td.text-end.pe-3
                    .d-flex.justify-content-end.gap-1
                      button.btn.btn-sm.btn-outline-primary(type="button" title="Edit")
                        i.bi.bi-pencil
                      button.btn.btn-sm.btn-outline-danger(type="button" title="Delete")
                        i.bi.bi-trash

    // =====================================================
    // Table with Caption
    // =====================================================
    .col-lg-12
      .card.mb-3
        .card-body
          h2.card-title Table with caption
          p.text-secondary
            | A
            code &lt;caption&gt;
            |  functions like a heading for a table and helps screen readers.

          .table-responsive
            table.table.table-hover
              caption Top 4 active database nodes in production cluster
              thead
                tr
                  th Node
                  th Engine
                  th Connections
                  th CPU Load
                  th Status
              tbody
                tr
                  td node-db-alpha-01
                  td PostgreSQL 16
                  td 142 / 500
                  td 24%
                  td
                    span.badge.bg-success Healthy
                tr
                  td node-db-alpha-02
                  td PostgreSQL 16
                  td 188 / 500
                  td 38%
                  td
                    span.badge.bg-success Healthy
                tr
                  td node-redis-cache-01
                  td Redis 7.2
                  td 412 / 1000
                  td 12%
                  td
                    span.badge.bg-success Healthy
                tr
                  td node-elastic-search-01
                  td Elasticsearch 8
                  td 88 / 200
                  td 65%
                  td
                    span.badge.bg-warning High Load
