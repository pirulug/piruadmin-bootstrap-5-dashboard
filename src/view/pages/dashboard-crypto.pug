block scripts
  script(src=assets + "plugins/chartjs/chartjs.js")

  script.
    document.addEventListener("DOMContentLoaded", function () {
      const getVar = (name) =>
        getComputedStyle(document.documentElement).getPropertyValue(name).trim();

      const primary = window.theme?.primary || "#e83283";
      const info = window.theme?.info || "#17a2b8";
      const success = window.theme?.success || "#28a745";
      const warning = window.theme?.warning || "#ffc107";
      const gridColor = getVar("--bs-border-color-translucent") || "rgba(120, 130, 140, 0.15)";
      const textColor = getVar("--bs-secondary-color") || "#6c757d";

      // 1. Crypto Price Chart
      const pairSeries = {
        btc: {
          price: "$91,420.00",
          change: "+3.18%",
          positive: true,
          labels: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
          data: [86400, 87900, 87200, 89100, 88650, 90300, 91420]
        },
        eth: {
          price: "$3,285.50",
          change: "+2.45%",
          positive: true,
          labels: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
          data: [3110, 3165, 3140, 3210, 3190, 3245, 3285.5]
        },
        sol: {
          price: "$214.80",
          change: "-1.15%",
          positive: false,
          labels: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
          data: [222, 224, 219, 221, 217, 216, 214.8]
        }
      };

      const priceChart = new Chart(document.getElementById("chartjs-crypto-price").getContext("2d"), {
        type: "line",
        data: {
          labels: pairSeries.btc.labels,
          datasets: [
            {
              label: "Price (USDT)",
              fill: true,
              backgroundColor: "rgba(232, 50, 131, 0.12)",
              borderColor: primary,
              borderWidth: 2,
              tension: 0.35,
              pointRadius: 2,
              pointHoverRadius: 5,
              data: pairSeries.btc.data
            }
          ]
        },
        options: {
          maintainAspectRatio: false,
          interaction: { intersect: false, mode: "index" },
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false }, ticks: { color: textColor } },
            y: {
              grid: { color: gridColor },
              ticks: {
                color: textColor,
                callback: (val) => "$" + Number(val).toLocaleString()
              }
            }
          }
        }
      });

      const pairSelect = document.getElementById("cryptoPairSelect");
      const pairPriceEl = document.getElementById("cryptoPairPrice");
      const pairChangeEl = document.getElementById("cryptoPairChange");

      if (pairSelect) {
        pairSelect.addEventListener("change", () => {
          const item = pairSeries[pairSelect.value];
          if (!item) return;
          pairPriceEl.textContent = item.price;
          pairChangeEl.textContent = item.change;
          pairChangeEl.className = item.positive
            ? "badge bg-success-subtle text-success"
            : "badge bg-danger-subtle text-danger";
          priceChart.data.labels = item.labels;
          priceChart.data.datasets[0].data = item.data;
          priceChart.update();
        });
      }

      document.querySelectorAll("[data-crypto-tf]").forEach((btn) => {
        btn.addEventListener("click", () => {
          document.querySelectorAll("[data-crypto-tf]").forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
        });
      });

      // 2. Portfolio Allocation Doughnut
      new Chart(document.getElementById("chartjs-crypto-allocation"), {
        type: "doughnut",
        data: {
          labels: ["Bitcoin", "Ethereum", "Solana", "Tether"],
          datasets: [
            {
              data: [48, 28, 14, 10],
              backgroundColor: [warning, info, primary, success],
              borderWidth: 0
            }
          ]
        },
        options: {
          maintainAspectRatio: false,
          cutout: "72%",
          plugins: { legend: { display: false } }
        }
      });

      // 3. Quick Buy Calculator
      const buyAmount = document.getElementById("buyAmountUsd");
      const buyAsset = document.getElementById("buyAssetSelect");
      const buyReceive = document.getElementById("buyReceiveAmount");

      const updateBuyEstimate = () => {
        if (!buyAmount || !buyAsset || !buyReceive) return;
        const usd = parseFloat(buyAmount.value) || 0;
        const price = parseFloat(buyAsset.value) || 1;
        const ticker = buyAsset.options[buyAsset.selectedIndex].text.match(/\(([^)]+)\)/)?.[1] || "";
        buyReceive.value = `${(usd / price).toFixed(6)} ${ticker}`;
      };

      if (buyAmount && buyAsset) {
        buyAmount.addEventListener("input", updateBuyEstimate);
        buyAsset.addEventListener("change", updateBuyEstimate);
      }

      // 4. Quick Sell Calculator
      const sellAmount = document.getElementById("sellAmountCoin");
      const sellReceive = document.getElementById("sellReceiveUsd");
      if (sellAmount && sellReceive) {
        sellAmount.addEventListener("input", () => {
          const coins = parseFloat(sellAmount.value) || 0;
          sellReceive.value = "$" + (coins * 91420).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        });
      }
    });
