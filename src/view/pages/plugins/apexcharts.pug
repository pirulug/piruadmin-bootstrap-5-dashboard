extends ../../layouts/dashboard

append config
  - pageName = 'ApexCharts'
  - pageUrl = 'plugins/apexcharts'

block styles
  link(rel="stylesheet", href=assets + "plugins/apexcharts/apexcharts.css")

block content
  .row.g-3.mb-3
    .col-lg-8
      .card.h-100
        .card-header
          h5.card-title.mb-0
            i.bi.bi-graph-up.me-2
            | Revenue &amp; Profit (Area Spline)
        .card-body
          #apex-area-chart

    .col-lg-4
      .card.h-100
        .card-header
          h5.card-title.mb-0
            i.bi.bi-pie-chart.me-2
            | Traffic Sources (Donut)
        .card-body.d-flex.align-items-center.justify-content-center
          #apex-donut-chart.w-100

  .row.g-3
    .col-lg-6
      .card.h-100
        .card-header
          h5.card-title.mb-0
            i.bi.bi-bar-chart.me-2
            | Monthly Orders (Bar Chart)
        .card-body
          #apex-bar-chart

    .col-lg-6
      .card.h-100
        .card-header
          h5.card-title.mb-0
            i.bi.bi-speedometer2.me-2
            | System KPIs (Radial Bar)
        .card-body
          #apex-radial-chart

block scripts
  script(src=assets + "plugins/apexcharts/apexcharts.js")
  script.
    document.addEventListener('DOMContentLoaded', function () {
      if (!window.ApexCharts) return;

      const areaChart = new ApexCharts(document.querySelector('#apex-area-chart'), {
        chart: {
          type: 'area',
          height: 310,
          toolbar: { show: false },
          background: 'transparent'
        },
        colors: ['#ff0055', '#0dcaf0'],
        dataLabels: { enabled: false },
        stroke: { curve: 'smooth', width: 2 },
        fill: {
          type: 'gradient',
          gradient: { opacityFrom: 0.35, opacityTo: 0.02 }
        },
        series: [
          { name: 'Revenue', data: [31, 40, 28, 51, 42, 82, 95] },
          { name: 'Profit', data: [15, 22, 18, 32, 29, 54, 68] }
        ],
        xaxis: {
          categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul']
        }
      });
      areaChart.render();

      const donutChart = new ApexCharts(document.querySelector('#apex-donut-chart'), {
        chart: {
          type: 'donut',
          height: 310,
          background: 'transparent'
        },
        colors: ['#ff0055', '#198754', '#0dcaf0', '#ffc107'],
        labels: ['Organic', 'Direct', 'Referral', 'Social'],
        series: [44, 26, 18, 12],
        legend: { position: 'bottom' },
        stroke: { width: 0 }
      });
      donutChart.render();

      const barChart = new ApexCharts(document.querySelector('#apex-bar-chart'), {
        chart: {
          type: 'bar',
          height: 290,
          toolbar: { show: false },
          background: 'transparent'
        },
        colors: ['#ff0055', '#6c757d'],
        plotOptions: {
          bar: { borderRadius: 4, columnWidth: '48%' }
        },
        dataLabels: { enabled: false },
        series: [
          { name: 'Completed', data: [44, 55, 57, 56, 61, 58] },
          { name: 'Pending', data: [12, 18, 14, 15, 11, 13] }
        ],
        xaxis: {
          categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
        }
      });
      barChart.render();

      const radialChart = new ApexCharts(document.querySelector('#apex-radial-chart'), {
        chart: {
          type: 'radialBar',
          height: 290,
          background: 'transparent'
        },
        colors: ['#ff0055', '#198754', '#0dcaf0', '#ffc107'],
        series: [84, 72, 65, 91],
        labels: ['Uptime', 'Conversion', 'Retention', 'Speed'],
        plotOptions: {
          radialBar: {
            dataLabels: {
              total: {
                show: true,
                label: 'Average',
                formatter: () => '78%'
              }
            }
          }
        }
      });
      radialChart.render();
    });
