extends ../../layouts/dashboard

append config
  - pageName = "Charts"
  - pageUrl = "plugins/charts"
  
block styles
  link(rel="stylesheet", href=assets + "plugins/prismjs/prismjs.css")

block content
  .row
    // Line Chart
    .col-12.col-lg-6
      .card.mb-3.flex-fill.w-100
        .card-header
          h5.card-title Line Chart
          h6.card-subtitle.text-muted
            | Line charts use
            code type: "line"
            |  and are ideal for trends over time.
        .card-body
          .chart
            canvas#chartjs-line
          .text-center.mt-3
            button.btn.btn-sm.btn-outline-secondary(type="button" data-bs-toggle="collapse" data-bs-target="#collapseChartLine" aria-expanded="false" aria-controls="collapseChartLine")
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseChartLine.mt-3
            .demo-code-preview(data-label="CODE EXAMPLE")
              button.copy-btn(type="button") Copy
              pre.language-js
                code.language-js.
                  new Chart(document.getElementById("chartjs-line"), {
                    type: "line",
                    data: {
                      labels: ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"],
                      datasets: [{
                        label: "Sales",
                        data: [2115,1562,1584,1892,1487,2223,2966,2448,2905,3838,2917,3327],
                        borderColor: "#ff0055",
                        backgroundColor: "transparent",
                        fill: true
                      }]
                    },
                    options: { maintainAspectRatio: false }
                  });

    // Bar Chart
    .col-12.col-lg-6
      .card.mb-3
        .card-header
          h5.card-title Bar Chart
          h6.card-subtitle.text-muted
            | Bar charts use
            code type: "bar"
            |  to compare values between categories.
        .card-body
          .chart
            canvas#chartjs-bar
          .text-center.mt-3
            button.btn.btn-sm.btn-outline-secondary(type="button" data-bs-toggle="collapse" data-bs-target="#collapseChartBar" aria-expanded="false" aria-controls="collapseChartBar")
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseChartBar.mt-3
            .demo-code-preview(data-label="CODE EXAMPLE")
              button.copy-btn(type="button") Copy
              pre.language-js
                code.language-js.
                  new Chart(document.getElementById("chartjs-bar"), {
                    type: "bar",
                    data: {
                      labels: ["Jan","Feb","Mar","Apr","May","Jun"],
                      datasets: [{
                        label: "Revenue",
                        data: [54,67,41,55,62,45],
                        backgroundColor: "#ff0055"
                      }]
                    },
                    options: { maintainAspectRatio: false }
                  });

    // Doughnut Chart
    .col-12.col-lg-6
      .card.mb-3
        .card-header
          h5.card-title Doughnut Chart
          h6.card-subtitle.text-muted
            | Doughnut charts use
            code type: "doughnut"
            |  for proportional data.
        .card-body
          .chart.chart-sm
            canvas#chartjs-doughnut
          .text-center.mt-3
            button.btn.btn-sm.btn-outline-secondary(type="button" data-bs-toggle="collapse" data-bs-target="#collapseChartDoughnut" aria-expanded="false" aria-controls="collapseChartDoughnut")
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseChartDoughnut.mt-3
            .demo-code-preview(data-label="CODE EXAMPLE")
              button.copy-btn(type="button") Copy
              pre.language-js
                code.language-js.
                  new Chart(document.getElementById("chartjs-doughnut"), {
                    type: "doughnut",
                    data: {
                      labels: ["Social","Search","Direct","Other"],
                      datasets: [{
                        data: [260,125,54,146],
                        backgroundColor: ["#ff0055","#17a2b8","#dc3545","#dee2e6"],
                        borderColor: "transparent"
                      }]
                    },
                    options: { maintainAspectRatio: false, cutout: "65%" }
                  });

    // Pie Chart
    .col-12.col-lg-6
      .card.mb-3
        .card-header
          h5.card-title Pie Chart
          h6.card-subtitle.text-muted
            | Pie charts use
            code type: "pie"
            |  to show percentage distribution.
        .card-body
          .chart.chart-sm
            canvas#chartjs-pie
          .text-center.mt-3
            button.btn.btn-sm.btn-outline-secondary(type="button" data-bs-toggle="collapse" data-bs-target="#collapseChartPie" aria-expanded="false" aria-controls="collapseChartPie")
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseChartPie.mt-3
            .demo-code-preview(data-label="CODE EXAMPLE")
              button.copy-btn(type="button") Copy
              pre.language-js
                code.language-js.
                  new Chart(document.getElementById("chartjs-pie"), {
                    type: "pie",
                    data: {
                      labels: ["Social","Search","Direct","Other"],
                      datasets: [{
                        data: [260,125,54,146],
                        backgroundColor: ["#ff0055","#17a2b8","#dc3545","#dee2e6"]
                      }]
                    },
                    options: { maintainAspectRatio: false }
                  });

    // Area Chart
    .col-12.col-lg-6
      .card.mb-3
        .card-header
          h5.card-title Area Chart
          h6.card-subtitle.text-muted
            | Area charts are line charts with
            code fill: true
            |  enabled.
        .card-body
          .chart
            canvas#chartjs-area
          .text-center.mt-3
            button.btn.btn-sm.btn-outline-secondary(type="button" data-bs-toggle="collapse" data-bs-target="#collapseChartArea" aria-expanded="false" aria-controls="collapseChartArea")
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseChartArea.mt-3
            .demo-code-preview(data-label="CODE EXAMPLE")
              button.copy-btn(type="button") Copy
              pre.language-js
                code.language-js.
                  new Chart(document.getElementById("chartjs-area"), {
                    type: "line",
                    data: {
                      labels: ["Mon","Tue","Wed","Thu","Fri"],
                      datasets: [{
                        label: "Visitors",
                        data: [120,190,300,250,220],
                        borderColor: "#17a2b8",
                        backgroundColor: "rgba(23,162,184,.3)",
                        fill: true
                      }]
                    },
                    options: { maintainAspectRatio: false }
                  });

    // Horizontal Bar Chart
    .col-12.col-lg-6
      .card.mb-3
        .card-header
          h5.card-title Horizontal Bar Chart
          h6.card-subtitle.text-muted
            | Horizontal bars use
            code indexAxis: "y"
            | .
        .card-body
          .chart
            canvas#chartjs-horizontal
          .text-center.mt-3
            button.btn.btn-sm.btn-outline-secondary(type="button" data-bs-toggle="collapse" data-bs-target="#collapseChartHorizontal" aria-expanded="false" aria-controls="collapseChartHorizontal")
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseChartHorizontal.mt-3
            .demo-code-preview(data-label="CODE EXAMPLE")
              button.copy-btn(type="button") Copy
              pre.language-js
                code.language-js.
                  new Chart(document.getElementById("chartjs-horizontal"), {
                    type: "bar",
                    data: {
                      labels: ["Chrome","Firefox","Safari","Edge"],
                      datasets: [{
                        label: "Users",
                        data: [65,59,80,81],
                        backgroundColor: "#ff0055"
                      }]
                    },
                    options: {
                      indexAxis: "y",
                      maintainAspectRatio: false
                    }
                  });

    // Grouped Bar Chart
    .col-12.col-lg-6
      .card.mb-3
        .card-header
          h5.card-title Grouped Bar Chart
          h6.card-subtitle.text-muted
            | Compare multiple datasets side-by-side per period.
        .card-body
          .chart
            canvas#chartjs-grouped-bar
          .text-center.mt-3
            button.btn.btn-sm.btn-outline-secondary(type="button" data-bs-toggle="collapse" data-bs-target="#collapseChartGroupedBar" aria-expanded="false" aria-controls="collapseChartGroupedBar")
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseChartGroupedBar.mt-3
            .demo-code-preview(data-label="CODE EXAMPLE")
              button.copy-btn(type="button") Copy
              pre.language-js
                code.language-js.
                  new Chart(document.getElementById("chartjs-grouped-bar"), {
                    type: "bar",
                    data: {
                      labels: ["Q1","Q2","Q3","Q4"],
                      datasets: [
                        {
                          label: "2025",
                          data: [42,55,68,80],
                          backgroundColor: "#6c757d"
                        },
                        {
                          label: "2026",
                          data: [58,74,89,105],
                          backgroundColor: "#ff0055"
                        }
                      ]
                    },
                    options: { maintainAspectRatio: false }
                  });

    // Stacked Bar Chart
    .col-12.col-lg-6
      .card.mb-3
        .card-header
          h5.card-title Stacked Bar Chart
          h6.card-subtitle.text-muted
            | Enable
            code stacked: true
            |  on x and y scales.
        .card-body
          .chart
            canvas#chartjs-stacked-bar
          .text-center.mt-3
            button.btn.btn-sm.btn-outline-secondary(type="button" data-bs-toggle="collapse" data-bs-target="#collapseChartStackedBar" aria-expanded="false" aria-controls="collapseChartStackedBar")
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseChartStackedBar.mt-3
            .demo-code-preview(data-label="CODE EXAMPLE")
              button.copy-btn(type="button") Copy
              pre.language-js
                code.language-js.
                  new Chart(document.getElementById("chartjs-stacked-bar"), {
                    type: "bar",
                    data: {
                      labels: ["Jan","Feb","Mar","Apr","May","Jun"],
                      datasets: [
                        { label: "Organic", data: [20,30,40,35,45,50], backgroundColor: "#17a2b8" },
                        { label: "Referral", data: [15,20,25,22,28,32], backgroundColor: "#ffc107" },
                        { label: "Paid", data: [25,35,45,40,50,60], backgroundColor: "#ff0055" }
                      ]
                    },
                    options: {
                      maintainAspectRatio: false,
                      scales: {
                        x: { stacked: true },
                        y: { stacked: true }
                      }
                    }
                  });

    // Multi-Axis Line Chart
    .col-12.col-lg-6
      .card.mb-3
        .card-header
          h5.card-title Multi-Axis Line Chart
          h6.card-subtitle.text-muted
            | Independent Y-axes with
            code yAxisID: "y"
            |  and
            code yAxisID: "y1"
            | .
        .card-body
          .chart
            canvas#chartjs-multi-axis
          .text-center.mt-3
            button.btn.btn-sm.btn-outline-secondary(type="button" data-bs-toggle="collapse" data-bs-target="#collapseChartMultiAxis" aria-expanded="false" aria-controls="collapseChartMultiAxis")
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseChartMultiAxis.mt-3
            .demo-code-preview(data-label="CODE EXAMPLE")
              button.copy-btn(type="button") Copy
              pre.language-js
                code.language-js.
                  new Chart(document.getElementById("chartjs-multi-axis"), {
                    type: "line",
                    data: {
                      labels: ["Jan","Feb","Mar","Apr","May","Jun"],
                      datasets: [
                        {
                          label: "Revenue ($k)",
                          data: [35,48,52,64,78,92],
                          borderColor: "#ff0055",
                          yAxisID: "y"
                        },
                        {
                          label: "Orders",
                          data: [120,180,210,290,340,410],
                          borderColor: "#17a2b8",
                          yAxisID: "y1"
                        }
                      ]
                    },
                    options: {
                      maintainAspectRatio: false,
                      scales: {
                        y: { type: "linear", position: "left" },
                        y1: { type: "linear", position: "right", grid: { drawOnChartArea: false } }
                      }
                    }
                  });

    // Stepped Line Chart
    .col-12.col-lg-6
      .card.mb-3
        .card-header
          h5.card-title Stepped Line Chart
          h6.card-subtitle.text-muted
            | Step progression line with
            code stepped: true
            | .
        .card-body
          .chart
            canvas#chartjs-stepped
          .text-center.mt-3
            button.btn.btn-sm.btn-outline-secondary(type="button" data-bs-toggle="collapse" data-bs-target="#collapseChartStepped" aria-expanded="false" aria-controls="collapseChartStepped")
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseChartStepped.mt-3
            .demo-code-preview(data-label="CODE EXAMPLE")
              button.copy-btn(type="button") Copy
              pre.language-js
                code.language-js.
                  new Chart(document.getElementById("chartjs-stepped"), {
                    type: "line",
                    data: {
                      labels: ["Day 1","Day 2","Day 3","Day 4","Day 5","Day 6"],
                      datasets: [{
                        label: "Active Server Instances",
                        data: [4,4,8,8,12,16],
                        borderColor: "#20c997",
                        backgroundColor: "rgba(32,201,151,0.15)",
                        stepped: true,
                        fill: true
                      }]
                    },
                    options: { maintainAspectRatio: false }
                  });

    // Radar Chart
    .col-12.col-lg-6
      .card.mb-3
        .card-header
          h5.card-title Radar Chart
          h6.card-subtitle.text-muted
            | Radar charts use
            code type: "radar"
            |  for multi-variable comparison.
        .card-body
          .chart
            canvas#chartjs-radar
          .text-center.mt-3
            button.btn.btn-sm.btn-outline-secondary(type="button" data-bs-toggle="collapse" data-bs-target="#collapseChartRadar" aria-expanded="false" aria-controls="collapseChartRadar")
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseChartRadar.mt-3
            .demo-code-preview(data-label="CODE EXAMPLE")
              button.copy-btn(type="button") Copy
              pre.language-js
                code.language-js.
                  new Chart(document.getElementById("chartjs-radar"), {
                    type: "radar",
                    data: {
                      labels: ["Speed","Reliability","Comfort","Safety","Efficiency"],
                      datasets: [{
                        label: "Car A",
                        data: [65,59,90,81,56],
                        backgroundColor: "rgba(255,0,85,.3)",
                        borderColor: "#ff0055"
                      }]
                    },
                    options: { maintainAspectRatio: false }
                  });

    // Polar Area Chart
    .col-12.col-lg-6
      .card.mb-3
        .card-header
          h5.card-title Polar Area Chart
          h6.card-subtitle.text-muted
            | Polar area charts use
            code type: "polarArea"
            | .
        .card-body
          .chart
            canvas#chartjs-polar
          .text-center.mt-3
            button.btn.btn-sm.btn-outline-secondary(type="button" data-bs-toggle="collapse" data-bs-target="#collapseChartPolar" aria-expanded="false" aria-controls="collapseChartPolar")
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseChartPolar.mt-3
            .demo-code-preview(data-label="CODE EXAMPLE")
              button.copy-btn(type="button") Copy
              pre.language-js
                code.language-js.
                  new Chart(document.getElementById("chartjs-polar"), {
                    type: "polarArea",
                    data: {
                      labels: ["Red","Blue","Yellow","Green"],
                      datasets: [{
                        data: [11,16,7,14],
                        backgroundColor: ["#ff0055","#17a2b8","#ffc107","#28a745"]
                      }]
                    },
                    options: { maintainAspectRatio: false }
                  });

    // Bubble Chart
    .col-12.col-lg-6
      .card.mb-3
        .card-header
          h5.card-title Bubble Chart
          h6.card-subtitle.text-muted
            | 3-dimensional data points with
            code x, y, r
            |  radius coordinates.
        .card-body
          .chart
            canvas#chartjs-bubble
          .text-center.mt-3
            button.btn.btn-sm.btn-outline-secondary(type="button" data-bs-toggle="collapse" data-bs-target="#collapseChartBubble" aria-expanded="false" aria-controls="collapseChartBubble")
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseChartBubble.mt-3
            .demo-code-preview(data-label="CODE EXAMPLE")
              button.copy-btn(type="button") Copy
              pre.language-js
                code.language-js.
                  new Chart(document.getElementById("chartjs-bubble"), {
                    type: "bubble",
                    data: {
                      datasets: [
                        {
                          label: "Product A",
                          data: [{x: 20, y: 30, r: 15}, {x: 40, y: 10, r: 10}, {x: 25, y: 40, r: 25}, {x: 35, y: 25, r: 18}],
                          backgroundColor: "rgba(255,0,85,0.6)"
                        },
                        {
                          label: "Product B",
                          data: [{x: 10, y: 40, r: 10}, {x: 30, y: 20, r: 20}, {x: 45, y: 35, r: 14}, {x: 15, y: 15, r: 12}],
                          backgroundColor: "rgba(23,162,184,0.6)"
                        }
                      ]
                    },
                    options: { maintainAspectRatio: false }
                  });

    // Scatter Chart
    .col-12.col-lg-6
      .card.mb-3
        .card-header
          h5.card-title Scatter Chart
          h6.card-subtitle.text-muted
            | Scatter plot plotting X and Y coordinate pairs.
        .card-body
          .chart
            canvas#chartjs-scatter
          .text-center.mt-3
            button.btn.btn-sm.btn-outline-secondary(type="button" data-bs-toggle="collapse" data-bs-target="#collapseChartScatter" aria-expanded="false" aria-controls="collapseChartScatter")
              i.bi.bi-code-slash.me-1
              | View Code
          .collapse#collapseChartScatter.mt-3
            .demo-code-preview(data-label="CODE EXAMPLE")
              button.copy-btn(type="button") Copy
              pre.language-js
                code.language-js.
                  new Chart(document.getElementById("chartjs-scatter"), {
                    type: "scatter",
                    data: {
                      datasets: [{
                        label: "Observations",
                        data: [
                          {x: -10, y: 0}, {x: 0, y: 10}, {x: 10, y: 5},
                          {x: 0.5, y: 5.5}, {x: 15, y: 25}, {x: 20, y: 18}
                        ],
                        backgroundColor: "#ff0055"
                      }]
                    },
                    options: { maintainAspectRatio: false }
                  });

block scripts
  script(src=assets + "plugins/chartjs/chartjs.js")
  script(src=assets + "plugins/prismjs/prismjs.js")

  script.
    // Line chart
    new Chart(document.getElementById("chartjs-line"), {
      type: "line",
      data: {
        labels: ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"],
        datasets: [{
          label: "Sales",
          data: [2115,1562,1584,1892,1487,2223,2966,2448,2905,3838,2917,3327],
          borderColor: "#ff0055",
          backgroundColor: "transparent",
          fill: true
        }]
      },
      options: { maintainAspectRatio: false }
    });

    // Bar chart
    new Chart(document.getElementById("chartjs-bar"), {
      type: "bar",
      data: {
        labels: ["Jan","Feb","Mar","Apr","May","Jun"],
        datasets: [{
          label: "Revenue",
          data: [54,67,41,55,62,45],
          backgroundColor: "#ff0055"
        }]
      },
      options: { maintainAspectRatio: false }
    });

    // Doughnut chart
    new Chart(document.getElementById("chartjs-doughnut"), {
      type: "doughnut",
      data: {
        labels: ["Social","Search","Direct","Other"],
        datasets: [{
          data: [260,125,54,146],
          backgroundColor: ["#ff0055","#17a2b8","#dc3545","#dee2e6"],
          borderColor: "transparent"
        }]
      },
      options: { maintainAspectRatio: false, cutout: "65%" }
    });

    // Pie chart
    new Chart(document.getElementById("chartjs-pie"), {
      type: "pie",
      data: {
        labels: ["Social","Search","Direct","Other"],
        datasets: [{
          data: [260,125,54,146],
          backgroundColor: ["#ff0055","#17a2b8","#dc3545","#dee2e6"]
        }]
      },
      options: { maintainAspectRatio: false }
    });

    // Area chart
    new Chart(document.getElementById("chartjs-area"), {
      type: "line",
      data: {
        labels: ["Mon","Tue","Wed","Thu","Fri"],
        datasets: [{
          label: "Visitors",
          data: [120,190,300,250,220],
          borderColor: "#17a2b8",
          backgroundColor: "rgba(23,162,184,.3)",
          fill: true
        }]
      },
      options: { maintainAspectRatio: false }
    });

    // Horizontal bar chart
    new Chart(document.getElementById("chartjs-horizontal"), {
      type: "bar",
      data: {
        labels: ["Chrome","Firefox","Safari","Edge"],
        datasets: [{
          label: "Users",
          data: [65,59,80,81],
          backgroundColor: "#ff0055"
        }]
      },
      options: {
        indexAxis: "y",
        maintainAspectRatio: false
      }
    });

    // Grouped bar chart
    new Chart(document.getElementById("chartjs-grouped-bar"), {
      type: "bar",
      data: {
        labels: ["Q1","Q2","Q3","Q4"],
        datasets: [
          {
            label: "2025",
            data: [42,55,68,80],
            backgroundColor: "#6c757d"
          },
          {
            label: "2026",
            data: [58,74,89,105],
            backgroundColor: "#ff0055"
          }
        ]
      },
      options: { maintainAspectRatio: false }
    });

    // Stacked bar chart
    new Chart(document.getElementById("chartjs-stacked-bar"), {
      type: "bar",
      data: {
        labels: ["Jan","Feb","Mar","Apr","May","Jun"],
        datasets: [
          { label: "Organic", data: [20,30,40,35,45,50], backgroundColor: "#17a2b8" },
          { label: "Referral", data: [15,20,25,22,28,32], backgroundColor: "#ffc107" },
          { label: "Paid", data: [25,35,45,40,50,60], backgroundColor: "#ff0055" }
        ]
      },
      options: {
        maintainAspectRatio: false,
        scales: {
          x: { stacked: true },
          y: { stacked: true }
        }
      }
    });

    // Multi-axis line chart
    new Chart(document.getElementById("chartjs-multi-axis"), {
      type: "line",
      data: {
        labels: ["Jan","Feb","Mar","Apr","May","Jun"],
        datasets: [
          {
            label: "Revenue ($k)",
            data: [35,48,52,64,78,92],
            borderColor: "#ff0055",
            yAxisID: "y"
          },
          {
            label: "Orders",
            data: [120,180,210,290,340,410],
            borderColor: "#17a2b8",
            yAxisID: "y1"
          }
        ]
      },
      options: {
        maintainAspectRatio: false,
        scales: {
          y: { type: "linear", position: "left" },
          y1: { type: "linear", position: "right", grid: { drawOnChartArea: false } }
        }
      }
    });

    // Stepped line chart
    new Chart(document.getElementById("chartjs-stepped"), {
      type: "line",
      data: {
        labels: ["Day 1","Day 2","Day 3","Day 4","Day 5","Day 6"],
        datasets: [{
          label: "Active Server Instances",
          data: [4,4,8,8,12,16],
          borderColor: "#20c997",
          backgroundColor: "rgba(32,201,151,0.15)",
          stepped: true,
          fill: true
        }]
      },
      options: { maintainAspectRatio: false }
    });

    // Radar chart
    new Chart(document.getElementById("chartjs-radar"), {
      type: "radar",
      data: {
        labels: ["Speed","Reliability","Comfort","Safety","Efficiency"],
        datasets: [{
          label: "Car A",
          data: [65,59,90,81,56],
          backgroundColor: "rgba(255,0,85,.3)",
          borderColor: "#ff0055"
        }]
      },
      options: { maintainAspectRatio: false }
    });

    // Polar area chart
    new Chart(document.getElementById("chartjs-polar"), {
      type: "polarArea",
      data: {
        labels: ["Red","Blue","Yellow","Green"],
        datasets: [{
          data: [11,16,7,14],
          backgroundColor: ["#ff0055","#17a2b8","#ffc107","#28a745"]
        }]
      },
      options: { maintainAspectRatio: false }
    });

    // Bubble chart
    new Chart(document.getElementById("chartjs-bubble"), {
      type: "bubble",
      data: {
        datasets: [
