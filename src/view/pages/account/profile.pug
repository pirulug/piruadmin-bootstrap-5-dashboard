extends ../../layouts/dashboard

append config
  - pageName = "Profile"
  - pageUrl = "account/profile"


block content
  .card.profile-header-card.mb-4.overflow-hidden
    .profile-cover-wrapper
      img.profile-cover.w-100(src="https://images.unsplash.com/photo-1557683316-973673baf926?q=80&w=2029&auto=format&fit=crop" alt="Cover Image")
    
    .card-body.pt-0
      .text-center
        .profile-avatar-container.mb-3
          img.rounded-circle.profile-avatar(src="https://dummyimage.com/200x200/222/fff.jpg" alt="Pirulug Avatar")
          .profile-status-online(title="Online")
          
        h2.fw-bold.mb-1.display-6 Pirulug
        p.text-body-secondary.mb-4.fs-5
          i.bi.bi-code-slash.me-2
          | Full Stack Developer & Open Source Architect
          span.mx-3.text-muted |
          i.bi.bi-geo-alt.me-1
          | Perú
          
        .d-flex.justify-content-center.gap-3.mb-5
          button.btn.btn-primary.px-5.py-2.rounded-pill
            i.bi.bi-person-plus-fill.me-2
            | Follow
          button.btn.btn-outline-primary.px-5.py-2.rounded-pill
            i.bi.bi-chat-dots.me-2
            | Message
          .dropdown
            button.btn.btn-outline-secondary.rounded-circle.p-2(type="button" data-bs-toggle="dropdown" style="width: 42px; height: 42px")
              i.bi.bi-three-dots-vertical
            ul.dropdown-menu.dropdown-menu-end
              li: a.dropdown-item(href="#") 
                i.bi.bi-share.me-2
                | Share Profile
              li: a.dropdown-item(href="#") 
                i.bi.bi-flag.me-2
                | Report User
              li: hr.dropdown-divider
              li: a.dropdown-item.text-danger(href="#") 
                i.bi.bi-slash-circle.me-2
                | Block User

        .row.g-3.justify-content-center.mb-2(style="max-width: 800px; margin: 0 auto;")
          .col-4.col-md-3
            .stat-card
              .h3.fw-bold.mb-0 1.2k
              .small.text-muted.text-uppercase.ls-1 Followers
          .col-4.col-md-3
            .stat-card
              .h3.fw-bold.mb-0 850
              .small.text-muted.text-uppercase.ls-1 Following
          .col-4.col-md-3
            .stat-card
              .h3.fw-bold.mb-0 42
              .small.text-muted.text-uppercase.ls-1 Projects
          .col-md-3.d-none.d-md-block
            .stat-card
              .h3.fw-bold.mb-0 15k
              .small.text-muted.text-uppercase.ls-1 Contributions

  .row.g-4
    .col-lg-4
      .card.mb-4
        .card-header.bg-transparent.py-3.border-0
          h5.card-title.mb-0.fw-bold.d-flex.align-items-center
            span.p-2.bg-primary-subtle.rounded-3.me-3
              i.bi.bi-person-circle.text-primary
            | Professional Info
        .card-body.pt-0
          p.text-body-secondary.mb-4
            | Building modern web experiences with a focus on performance, scalability, and user-centric design. Passionate about automation and clean code.
          
          ul.list-unstyled.d-grid.gap-4.mb-0
            li.d-flex
              .flex-shrink-0
                i.bi.bi-envelope-at.fs-5.text-primary
              .ms-3
                small.text-muted.d-block Email
                span.fw-medium pirulug@example.com
            li.d-flex
              .flex-shrink-0
                i.bi.bi-calendar-check.fs-5.text-primary
              .ms-3
                small.text-muted.d-block Joined
                span.fw-medium May 2021
            li.d-flex
              .flex-shrink-0
                i.bi.bi-link-45deg.fs-5.text-primary
              .ms-3
                small.text-muted.d-block Portfolio
                a.fw-medium.text-decoration-none(href="https://pirulug.com" target="_blank") pirulug.com

      .card
        .card-header.bg-transparent.py-3.border-0
          h5.card-title.mb-0.fw-bold.d-flex.align-items-center
            span.p-2.bg-info-subtle.rounded-3.me-3
              i.bi.bi-stars.text-info
            | Expertise & Skills
        .card-body.pt-0
          .d-flex.flex-wrap.gap-2
            span.skill-badge 
              i.bi.bi-filetype-py.me-2
              | Python
            span.skill-badge 
              i.bi.bi-braces.me-2
              | JavaScript
            span.skill-badge 
              i.bi.bi-database.me-2
              | PostgreSQL
            span.skill-badge 
              i.bi.bi-clouds.me-2
              | AWS Cloud
            span.skill-badge 
              i.bi.bi-git.me-2
              | Git Flow
            span.skill-badge 
              i.bi.bi-window-stack.me-2
              | UI/UX Design

    .col-lg-8
      .card
        .card-header.bg-transparent.py-3.border-0.d-flex.justify-content-between.align-items-center
          h5.card-title.mb-0.fw-bold Activity Timeline
          .dropdown
            button.btn.btn-sm.btn-outline-secondary.dropdown-toggle(type="button" data-bs-toggle="dropdown") Last 30 Days
            ul.dropdown-menu
              li: a.dropdown-item(href="#") Last 7 Days
              li: a.dropdown-item(href="#") Last 6 Months
              li: a.dropdown-item(href="#") All Time
        
        .card-body.pt-0.position-relative
          .activity-line
          
          .d-flex.gap-4.mb-5.position-relative
            .activity-dot.mt-2
            .flex-grow-1
              .d-flex.justify-content-between.align-items-center.mb-2
                span.badge.bg-success-subtle.text-success.px-3 Committed
                small.text-muted 10 mins ago
              h6.fw-bold.mb-2 Pushed new changes to "piruadmin-core"
              p.text-body-secondary.mb-3
                | Optimized the sidebar state management and updated Bootstrap icons to version 1.11.3.
              .card.bg-body-tertiary
                .card-body.p-3
                  .d-flex.align-items-center
                    i.bi.bi-git.fs-4.me-3.text-primary
                    div
                      div.fw-bold refactor: improve sidebar performance
                      small.text-muted hash: 7d47937 &bull; main branch

          .d-flex.gap-4.mb-5.position-relative
            .activity-dot.mt-2.bg-info
            .flex-grow-1
              .d-flex.justify-content-between.align-items-center.mb-2
                span.badge.bg-info-subtle.text-info.px-3 Project
                small.text-muted 5 hours ago
              h6.fw-bold.mb-2 Created a new repository
              p.text-body-secondary.mb-0
                | Started working on 
                a.text-primary.text-decoration-none.fw-medium(href="#") awesome-bootstrap-dashboard
                | . A collection of premium layouts.

          .d-flex.gap-4.mb-2.position-relative
            .activity-dot.mt-2.bg-warning
            .flex-grow-1
              .d-flex.justify-content-between.align-items-center.mb-2
                span.badge.bg-warning-subtle.text-warning.px-3 Starred
                small.text-muted Yesterday
              h6.fw-bold.mb-0 You starred "mermaid-js" repository.

          .text-center.mt-5
            button.btn.btn-outline-secondary.rounded-pill.px-5 Load older activities
