extends ../../layouts/auth

append config
  - pageName = "Two-Step Verification Code"
  - pageUrl = "pages-2fa-code"

block content
  .d-flex.min-vh-100.align-items-center.justify-content-center.py-4
    .container
      .row.justify-content-center
        .col-12.col-sm-10.col-md-8.col-lg-6.col-xl-5

          .text-center.mb-4
            .auth-logo-box.d-inline-flex.align-items-center.justify-content-center.text-white.rounded-3.mb-3(style="width: 44px; height: 44px;")
              i.bi.bi-shield-lock
            h5.fw-bold.mb-1 Two-Step Verification
            p.text-body-secondary.small Enter the code generated by your Google Authenticator app

          .card.auth-card.border-0.rounded-3
            .card-body.p-4
              
              form(action=baseUrl + "dashboard.html")
                .mb-4.text-center
                  p.text-body-secondary.small.mb-4 Please type the 6-digit verification code below.

                  .d-flex.gap-2.mb-4.justify-content-center
                    input.form-control.text-center.fw-bold.fs-4.p-2.verification-code-input(type="text" maxlength="1" style="width: 50px; height: 50px;" required)
                    input.form-control.text-center.fw-bold.fs-4.p-2.verification-code-input(type="text" maxlength="1" style="width: 50px; height: 50px;" required)
                    input.form-control.text-center.fw-bold.fs-4.p-2.verification-code-input(type="text" maxlength="1" style="width: 50px; height: 50px;" required)
                    input.form-control.text-center.fw-bold.fs-4.p-2.verification-code-input(type="text" maxlength="1" style="width: 50px; height: 50px;" required)
                    input.form-control.text-center.fw-bold.fs-4.p-2.verification-code-input(type="text" maxlength="1" style="width: 50px; height: 50px;" required)
                    input.form-control.text-center.fw-bold.fs-4.p-2.verification-code-input(type="text" maxlength="1" style="width: 50px; height: 50px;" required)

                .d-grid.mb-3
                  button.btn.btn-primary(type="submit") Confirm & Login

                .text-center
                  a.small.text-decoration-none.auth-footer-link(href="#") Lost your device? Use backup code

          .text-center.mt-3
            a.small.text-decoration-none.auth-footer-link(href=baseUrl + "auth/sign-in.html") Back to Sign In

  script.
    document.addEventListener("DOMContentLoaded", () => {
      const inputs = document.querySelectorAll(".verification-code-input");
      inputs.forEach((input, index) => {
        input.addEventListener("input", (e) => {
          if (e.target.value.length === 1 && index < inputs.length - 1) {
            inputs[index + 1].focus();
          }
        });
        input.addEventListener("keydown", (e) => {
          if (e.key === "Backspace" && e.target.value.length === 0 && index > 0) {
            inputs[index - 1].focus();
          }
        });
      });
    });
