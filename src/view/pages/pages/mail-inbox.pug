extends ../../layouts/dashboard

append config
  - pageName = "Inbox"
  - pageUrl = "pages/mail-inbox"

block styles

block scripts

block content
  // Top Filters & Actions
  .bg-body.p-3.rounded.mb-3.text-end
    a.btn.btn-primary.text-uppercase.fw-bold(href=baseUrl + "pages/mail-compose.html")
      i.bi.bi-pencil-square.me-1
      span Compose
    hr.my-2

    form(method="GET" autocomplete="off")
      .d-flex.flex-wrap.justify-content-end.align-items-center.gap-2
        select.form-select.w-auto(name="folder" aria-label="All Folders")
          option(value="inbox" selected) Inbox (12)
          option(value="starred") Starred
          option(value="sent") Sent
          option(value="drafts") Drafts
          option(value="trash") Trash

        select.form-select.w-auto(name="label" aria-label="All Labels")
          option(value="" selected) All Labels
          option(value="important") Important
          option(value="work") Work
          option(value="clients") Clients

        .input-group.w-auto.flex-grow-1(style="max-width: 450px;")
          input.form-control(type="text" name="search" placeholder="Search emails by sender, subject..." value="")
          button.btn.btn-primary.px-3.text-uppercase.small.fw-bold.text-nowrap(type="submit")
            i.bi.bi-search.me-1
            | Filter

  // Emails Data Table
  .bg-body.p-3.rounded.mb-3
    .table-responsive
      table.table.table-hover.align-middle.table-sm.m-0
        thead
          tr
            th.ps-2(style="width: 40px")
              input.form-check-input(type="checkbox" aria-label="Select all")
            th.text-uppercase.fw-bold.text-nowrap(style="width: 40px")
            th.text-uppercase.fw-bold.text-nowrap Sender
            th.text-uppercase.fw-bold.text-nowrap Subject &amp; Summary
            th.text-uppercase.fw-bold.text-nowrap Label
            th.text-uppercase.fw-bold.text-nowrap Date
            th.text-end.pe-3.text-uppercase.fw-bold.text-nowrap Actions
        tbody
          tr
            td.ps-2
              input.form-check-input(type="checkbox")
            td
              i.bi.bi-star-fill.text-warning.cursor-pointer
            td
              .fw-bold.text-body Sarah Connor
              .small.text-body-secondary Cyberdyne Systems
            td
              a.text-decoration-none.text-body(href=baseUrl + "pages/mail-read.html")
                span.fw-bold Project Status Update - Q3 Milestones
                span.text-body-secondary.ms-2 — Here is the updated milestone schedule for the dashboard release...
            td
              span.badge.bg-primary-subtle.text-primary Work
            td 10:42 AM
            td.text-end.pe-3.text-nowrap
              .d-flex.justify-content-end.gap-1
                a.btn.btn-sm.btn-outline-info.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/mail-read.html" title="Read")
                  i.bi.bi-eye.me-1
                  | Read
                button.btn.btn-sm.btn-outline-danger.text-uppercase.fw-bold.text-nowrap(type="button" title="Delete")
                  i.bi.bi-trash.me-1
                  | Delete
          tr
            td.ps-2
              input.form-check-input(type="checkbox")
            td
              i.bi.bi-star.text-body-tertiary.cursor-pointer
            td
              .fw-bold.text-body GitHub Notifications
              .small.text-body-secondary notifications@github.com
            td
              a.text-decoration-none.text-body(href=baseUrl + "pages/mail-read.html")
                span.fw-bold [piruadmin] New pull request #42
                span.text-body-secondary.ms-2 — feat(sidebar): recursive multi-level navigation rendering merged...
            td
              span.badge.bg-info-subtle.text-info System
            td Yesterday
            td.text-end.pe-3.text-nowrap
              .d-flex.justify-content-end.gap-1
                a.btn.btn-sm.btn-outline-info.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/mail-read.html" title="Read")
                  i.bi.bi-eye.me-1
                  | Read
                button.btn.btn-sm.btn-outline-danger.text-uppercase.fw-bold.text-nowrap(type="button" title="Delete")
                  i.bi.bi-trash.me-1
                  | Delete
          tr
            td.ps-2
              input.form-check-input(type="checkbox")
            td
              i.bi.bi-star-fill.text-warning.cursor-pointer
            td
              .fw-bold.text-body Alex Mercer
              .small.text-body-secondary alex.m@designstudio.io
            td
              a.text-decoration-none.text-body(href=baseUrl + "pages/mail-read.html")
                span.fw-bold Brand Guidelines &amp; Vector Assets
                span.text-body-secondary.ms-2 — Attached please find the latest SVG icons and typography sheets...
            td
              span.badge.bg-success-subtle.text-success Design
            td Aug 20
            td.text-end.pe-3.text-nowrap
              .d-flex.justify-content-end.gap-1
                a.btn.btn-sm.btn-outline-info.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/mail-read.html" title="Read")
                  i.bi.bi-eye.me-1
                  | Read
                button.btn.btn-sm.btn-outline-danger.text-uppercase.fw-bold.text-nowrap(type="button" title="Delete")
                  i.bi.bi-trash.me-1
                  | Delete
          tr
            td.ps-2
              input.form-check-input(type="checkbox")
            td
              i.bi.bi-star.text-body-tertiary.cursor-pointer
            td
              .fw-bold.text-body Stripe Billing
              .small.text-body-secondary invoice+statements@stripe.com
            td
              a.text-decoration-none.text-body(href=baseUrl + "pages/mail-read.html")
                span.fw-bold Monthly Invoice #INV-2026-0881
                span.text-body-secondary.ms-2 — Your monthly subscription has been renewed successfully. Receipt attached...
            td
              span.badge.bg-warning-subtle.text-warning Billing
            td Aug 18
            td.text-end.pe-3.text-nowrap
              .d-flex.justify-content-end.gap-1
                a.btn.btn-sm.btn-outline-info.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/mail-read.html" title="Read")
                  i.bi.bi-eye.me-1
                  | Read
                button.btn.btn-sm.btn-outline-danger.text-uppercase.fw-bold.text-nowrap(type="button" title="Delete")
                  i.bi.bi-trash.me-1
                  | Delete

  // Pagination
  .bg-body.p-3.rounded.d-flex.flex-column.flex-md-row.align-items-center.justify-content-between.gap-2.sticky-bottom
    .legend
      span.fw-bold Showing 1 - 4 of 48 messages
    .paginator
      nav(aria-label="Mail pagination")
        ul.pagination.justify-content-end.mb-0
          li.page-item.disabled
            a.page-link.text-uppercase.small.fw-bold(href="#" aria-label="First")
              i.bi.bi-chevron-double-left.small
          li.page-item.disabled
            a.page-link(href="#" aria-label="Previous")
              i.bi.bi-chevron-left.small
          li.page-item.active
            a.page-link(href="#") 1
          li.page-item
            a.page-link(href="#") 2
          li.page-item
            a.page-link(href="#") 3
          li.page-item.disabled
            span.page-link ...
          li.page-item
            a.page-link(href="#") 12
          li.page-item
            a.page-link(href="#" aria-label="Next")
              i.bi.bi-chevron-right.small
          li.page-item
            a.page-link.text-uppercase.small.fw-bold(href="#" aria-label="Last")
              i.bi.bi-chevron-double-right.small
