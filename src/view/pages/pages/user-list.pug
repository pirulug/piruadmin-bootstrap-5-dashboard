extends ../../layouts/dashboard

append config
  - pageName = "List User"
  - pageUrl = "pages/user-list"

block styles

block scripts

block content
  // Top Filters & Actions
  .bg-body.p-3.rounded.mb-3.text-end
    a.btn.btn-primary.text-uppercase.fw-bold(href=baseUrl + "pages/user-add.html")
      i.bi.bi-plus.me-1
      span New User
    hr.my-2

    form(method="GET" autocomplete="off")
      .d-flex.flex-wrap.justify-content-end.align-items-center.gap-2
        select.form-select.w-auto(name="role" aria-label="All roles")
          option(value="" selected) All roles
          option(value="admin") Administrator
          option(value="editor") Editor
          option(value="manager") Manager
          option(value="user") Standard User

        select.form-select.w-auto(name="status" aria-label="All statuses")
          option(value="" selected) All statuses
          option(value="1") Active
          option(value="0") Inactive

        .input-group.w-auto.flex-grow-1(style="max-width: 450px;")
          input.form-control(type="text" name="search" placeholder="Search by name, email or role..." value="")
          button.btn.btn-primary.px-3.text-uppercase.small.fw-bold.text-nowrap(type="submit")
            i.bi.bi-search.me-1
            | Filter

  // Data Table
  .bg-body.p-3.rounded.mb-3
    .table-responsive
      table.table.table-hover.align-middle.table-sm.m-0
        thead
          tr
            th.ps-2.text-uppercase.fw-bold.text-nowrap User
            th.text-uppercase.fw-bold.text-nowrap Role
            th.text-uppercase.fw-bold.text-nowrap Department
            th.text-uppercase.fw-bold.text-nowrap Status
            th.text-uppercase.fw-bold.text-nowrap Joined Date
            th.text-end.pe-3.text-uppercase.fw-bold.text-nowrap Actions
        tbody
          tr
            td.ps-2
              .d-flex.align-items-center
                .rounded-circle.bg-primary.text-white.d-flex.align-items-center.justify-content-center.me-2(style="width: 34px; height: 34px; font-weight: 600; font-size: 0.8rem")
                  | JD
                div
                  .fw-bold.text-body Jane Doe
                  .small.text-body-secondary jane.doe@example.com
            td
              span.badge.bg-primary-subtle.text-primary Administrator
            td Engineering
            td
              span.badge.bg-success Active
            td Jan 12, 2026
            td.text-end.pe-3.text-nowrap
              .d-flex.justify-content-end.gap-1
                a.btn.btn-sm.btn-outline-info.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/user-view.html" title="View")
                  i.bi.bi-eye.me-1
                  | View
                a.btn.btn-sm.btn-outline-primary.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/user-add.html" title="Edit")
                  i.bi.bi-pencil.me-1
                  | Edit
                button.btn.btn-sm.btn-outline-danger.text-uppercase.fw-bold.text-nowrap(type="button" title="Delete")
                  i.bi.bi-trash.me-1
                  | Delete
          tr
            td.ps-2
              .d-flex.align-items-center
                .rounded-circle.bg-success.text-white.d-flex.align-items-center.justify-content-center.me-2(style="width: 34px; height: 34px; font-weight: 600; font-size: 0.8rem")
                  | AS
                div
                  .fw-bold.text-body Alex Smith
                  .small.text-body-secondary alex.smith@example.com
            td
              span.badge.bg-info-subtle.text-info Editor
            td Marketing
            td
              span.badge.bg-success Active
            td Feb 04, 2026
            td.text-end.pe-3.text-nowrap
              .d-flex.justify-content-end.gap-1
                a.btn.btn-sm.btn-outline-info.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/user-view.html" title="View")
                  i.bi.bi-eye.me-1
                  | View
                a.btn.btn-sm.btn-outline-primary.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/user-add.html" title="Edit")
                  i.bi.bi-pencil.me-1
                  | Edit
                button.btn.btn-sm.btn-outline-danger.text-uppercase.fw-bold.text-nowrap(type="button" title="Delete")
                  i.bi.bi-trash.me-1
                  | Delete
          tr
            td.ps-2
              .d-flex.align-items-center
                .rounded-circle.bg-warning.text-white.d-flex.align-items-center.justify-content-center.me-2(style="width: 34px; height: 34px; font-weight: 600; font-size: 0.8rem")
                  | MG
                div
                  .fw-bold.text-body Maria Garcia
                  .small.text-body-secondary maria.garcia@example.com
            td
              span.badge.bg-secondary-subtle.text-secondary Standard User
            td Design
            td
              span.badge.bg-warning Pending
            td Mar 18, 2026
            td.text-end.pe-3.text-nowrap
              .d-flex.justify-content-end.gap-1
                a.btn.btn-sm.btn-outline-info.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/user-view.html" title="View")
                  i.bi.bi-eye.me-1
                  | View
                a.btn.btn-sm.btn-outline-primary.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/user-add.html" title="Edit")
                  i.bi.bi-pencil.me-1
                  | Edit
                button.btn.btn-sm.btn-outline-danger.text-uppercase.fw-bold.text-nowrap(type="button" title="Delete")
                  i.bi.bi-trash.me-1
                  | Delete
          tr
            td.ps-2
              .d-flex.align-items-center
                .rounded-circle.bg-danger.text-white.d-flex.align-items-center.justify-content-center.me-2(style="width: 34px; height: 34px; font-weight: 600; font-size: 0.8rem")
                  | RK
                div
                  .fw-bold.text-body Robert Kim
                  .small.text-body-secondary robert.kim@example.com
            td
              span.badge.bg-warning-subtle.text-warning Manager
            td Support
            td
              span.badge.bg-secondary Suspended
            td Apr 01, 2026
            td.text-end.pe-3.text-nowrap
              .d-flex.justify-content-end.gap-1
                a.btn.btn-sm.btn-outline-info.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/user-view.html" title="View")
                  i.bi.bi-eye.me-1
                  | View
                a.btn.btn-sm.btn-outline-primary.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/user-add.html" title="Edit")
                  i.bi.bi-pencil.me-1
                  | Edit
                button.btn.btn-sm.btn-outline-danger.text-uppercase.fw-bold.text-nowrap(type="button" title="Delete")
                  i.bi.bi-trash.me-1
                  | Delete

  // Pagination
  .bg-body.p-3.rounded.d-flex.flex-column.flex-md-row.align-items-center.justify-content-between.gap-2.sticky-bottom
    .legend
      span.fw-bold Showing 1 - 4 of 1,429 users
    .paginator
      nav(aria-label="Users pagination")
        ul.pagination.justify-content-end.mb-0
          li.page-item.disabled
            a.page-link.text-uppercase.small.fw-bold(href="#" aria-label="First")
              i.bi.bi-chevron-double-left.small
          li.page-item.disabled
            a.page-link(href="#" aria-label="Previous")
              i.bi.bi-chevron-left.small
          li.page-item.active
            a.page-link(href="#") 1
          li.page-item
            a.page-link(href="#") 2
          li.page-item
            a.page-link(href="#") 3
          li.page-item.disabled
            span.page-link ...
          li.page-item
            a.page-link(href="#") 100
          li.page-item
            a.page-link(href="#" aria-label="Next")
              i.bi.bi-chevron-right.small
          li.page-item
            a.page-link.text-uppercase.small.fw-bold(href="#" aria-label="Last")
              i.bi.bi-chevron-double-right.small
