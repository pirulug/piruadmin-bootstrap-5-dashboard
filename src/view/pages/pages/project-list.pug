extends ../../layouts/dashboard

append config
  - pageName = "Project List"
  - pageUrl = "pages/project-list"

block styles

block scripts

block content
  // Top Filters & Actions
  .bg-body.p-3.rounded.mb-3.text-end
    a.btn.btn-primary.text-uppercase.fw-bold(href=baseUrl + "pages/project-create.html")
      i.bi.bi-plus.me-1
      span New Project
    hr.my-2

    form(method="GET" autocomplete="off")
      .d-flex.flex-wrap.justify-content-end.align-items-center.gap-2
        select.form-select.w-auto(name="category" aria-label="All categories")
          option(value="" selected) All categories
          option(value="web") Web Development
          option(value="mobile") Mobile App
          option(value="design") UI/UX Design
          option(value="marketing") Marketing

        select.form-select.w-auto(name="status" aria-label="All statuses")
          option(value="" selected) All statuses
          option(value="in-progress") In Progress
          option(value="completed") Completed
          option(value="on-hold") On Hold

        .input-group.w-auto.flex-grow-1(style="max-width: 450px;")
          input.form-control(type="text" name="search" placeholder="Search by project, client, or tech..." value="")
          button(type="submit").btn.btn-primary.px-3.text-uppercase.small.fw-bold.text-nowrap
            i.bi.bi-search.me-1
            | Filter

  // Data Table
  .bg-body.p-3.rounded.mb-3
    .table-responsive
      table.table.table-hover.align-middle.table-sm.m-0
        thead
          tr
            th.ps-2.text-uppercase.fw-bold.text-nowrap Project
            th.text-uppercase.fw-bold.text-nowrap Client
            th.text-uppercase.fw-bold.text-nowrap Team
            th.text-uppercase.fw-bold.text-nowrap Progress
            th.text-uppercase.fw-bold.text-nowrap Status
            th.text-uppercase.fw-bold.text-nowrap Due Date
            th.text-end.pe-3.text-uppercase.fw-bold.text-nowrap Actions
        tbody
          tr
            td.ps-2
              .d-flex.align-items-center
                .p-2.rounded.bg-primary-subtle.text-primary.me-2.d-flex.align-items-center.justify-content-center(style="width: 38px; height: 38px")
                  i.bi.bi-kanban.fs-5
                <div>
                  .fw-bold.text-body PiruAdmin Dashboard v2
                  .small.text-body-secondary Web Development
                </div>
            td Acme Corp
            td
              .d-flex.align-items-center
                .rounded-circle.bg-primary.text-white.d-flex.align-items-center.justify-content-center(style="width: 26px; height: 26px; font-size: 0.7rem") JD
                .rounded-circle.bg-success.text-white.d-flex.align-items-center.justify-content-center.ms-n1(style="width: 26px; height: 26px; font-size: 0.7rem") AS
                .rounded-circle.bg-warning.text-white.d-flex.align-items-center.justify-content-center.ms-n1(style="width: 26px; height: 26px; font-size: 0.7rem") MG
            td
              .d-flex.align-items-center.gap-2
                .progress.flex-grow-1(style="height: 6px; min-width: 80px")
                  .progress-bar.bg-primary(role="progressbar" style="width: 75%" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100")
                span.small.fw-bold 75%
            td
              span.badge.bg-primary-subtle.text-primary In Progress
            td Oct 15, 2026
            td.text-end.pe-3.text-nowrap
              .d-flex.justify-content-end.gap-1
                a.btn.btn-sm.btn-outline-info.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/project-details.html" title="View")
                  i.bi.bi-eye.me-1
                  | View
                a.btn.btn-sm.btn-outline-primary.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/project-create.html" title="Edit")
                  i.bi.bi-pencil.me-1
                  | Edit
                button.btn.btn-sm.btn-outline-danger.text-uppercase.fw-bold.text-nowrap(type="button" title="Delete")
                  i.bi.bi-trash.me-1
                  | Delete
          tr
            td.ps-2
              .d-flex.align-items-center
                .p-2.rounded.bg-success-subtle.text-success.me-2.d-flex.align-items-center.justify-content-center(style="width: 38px; height: 38px")
                  i.bi.bi-phone.fs-5
                <div>
                  .fw-bold.text-body HealthTrack Mobile iOS
                  .small.text-body-secondary Mobile App
                </div>
            td BioHealth Inc.
            td
              .d-flex.align-items-center
                .rounded-circle.bg-danger.text-white.d-flex.align-items-center.justify-content-center(style="width: 26px; height: 26px; font-size: 0.7rem") RK
                .rounded-circle.bg-info.text-white.d-flex.align-items-center.justify-content-center.ms-n1(style="width: 26px; height: 26px; font-size: 0.7rem") EW
            td
              .d-flex.align-items-center.gap-2
                .progress.flex-grow-1(style="height: 6px; min-width: 80px")
                  .progress-bar.bg-success(role="progressbar" style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100")
                span.small.fw-bold 100%
            td
              span.badge.bg-success Completed
            td Sep 28, 2026
            td.text-end.pe-3.text-nowrap
              .d-flex.justify-content-end.gap-1
                a.btn.btn-sm.btn-outline-info.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/project-details.html" title="View")
                  i.bi.bi-eye.me-1
                  | View
                a.btn.btn-sm.btn-outline-primary.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/project-create.html" title="Edit")
                  i.bi.bi-pencil.me-1
                  | Edit
                button.btn.btn-sm.btn-outline-danger.text-uppercase.fw-bold.text-nowrap(type="button" title="Delete")
                  i.bi.bi-trash.me-1
                  | Delete
          tr
            td.ps-2
              .d-flex.align-items-center
                .p-2.rounded.bg-warning-subtle.text-warning.me-2.d-flex.align-items-center.justify-content-center(style="width: 38px; height: 38px")
                  i.bi.bi-palette.fs-5
                <div>
                  .fw-bold.text-body SaaS Brand Redesign
                  .small.text-body-secondary UI/UX Design
                </div>
            td CloudScale Labs
            td
              .d-flex.align-items-center
                .rounded-circle.bg-warning.text-white.d-flex.align-items-center.justify-content-center(style="width: 26px; height: 26px; font-size: 0.7rem") MG
                .rounded-circle.bg-primary.text-white.d-flex.align-items-center.justify-content-center.ms-n1(style="width: 26px; height: 26px; font-size: 0.7rem") JD
            td
              .d-flex.align-items-center.gap-2
                .progress.flex-grow-1(style="height: 6px; min-width: 80px")
                  .progress-bar.bg-warning(role="progressbar" style="width: 40%" aria-valuenow="40" aria-valuemin="0" aria-valuemax="100")
                span.small.fw-bold 40%
            td
              span.badge.bg-warning-subtle.text-warning In Progress
            td Nov 10, 2026
            td.text-end.pe-3.text-nowrap
              .d-flex.justify-content-end.gap-1
                a.btn.btn-sm.btn-outline-info.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/project-details.html" title="View")
                  i.bi.bi-eye.me-1
                  | View
                a.btn.btn-sm.btn-outline-primary.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/project-create.html" title="Edit")
                  i.bi.bi-pencil.me-1
                  | Edit
                button.btn.btn-sm.btn-outline-danger.text-uppercase.fw-bold.text-nowrap(type="button" title="Delete")
                  i.bi.bi-trash.me-1
                  | Delete
          tr
            td.ps-2
              .d-flex.align-items-center
                .p-2.rounded.bg-danger-subtle.text-danger.me-2.d-flex.align-items-center.justify-content-center(style="width: 38px; height: 38px")
                  i.bi.bi-shield-check.fs-5
                <div>
                  .fw-bold.text-body Security Audit &amp; Penetration Test
                  .small.text-body-secondary Cybersecurity
                </div>
            td Apex Financial
            td
              .d-flex.align-items-center
                .rounded-circle.bg-danger.text-white.d-flex.align-items-center.justify-content-center(style="width: 26px; height: 26px; font-size: 0.7rem") RK
            td
              .d-flex.align-items-center.gap-2
                .progress.flex-grow-1(style="height: 6px; min-width: 80px")
                  .progress-bar.bg-secondary(role="progressbar" style="width: 15%" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100")
                span.small.fw-bold 15%
            td
              span.badge.bg-secondary On Hold
            td Dec 05, 2026
            td.text-end.pe-3.text-nowrap
              .d-flex.justify-content-end.gap-1
                a.btn.btn-sm.btn-outline-info.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/project-details.html" title="View")
                  i.bi.bi-eye.me-1
                  | View
                a.btn.btn-sm.btn-outline-primary.text-uppercase.fw-bold.text-nowrap(href=baseUrl + "pages/project-create.html" title="Edit")
                  i.bi.bi-pencil.me-1
                  | Edit
                button.btn.btn-sm.btn-outline-danger.text-uppercase.fw-bold.text-nowrap(type="button" title="Delete")
                  i.bi.bi-trash.me-1
                  | Delete

  // Pagination
  .bg-body.p-3.rounded.d-flex.flex-column.flex-md-row.align-items-center.justify-content-between.gap-2.sticky-bottom
    .legend
      span.fw-bold Showing 1 - 4 of 28 projects
    .paginator
      nav(aria-label="Projects pagination")
        ul.pagination.justify-content-end.mb-0
          li.page-item.disabled
            a.page-link.text-uppercase.small.fw-bold(href="#" aria-label="First")
              i.bi.bi-chevron-double-left.small
          li.page-item.disabled
            a.page-link(href="#" aria-label="Previous")
              i.bi.bi-chevron-left.small
          li.page-item.active
            a.page-link(href="#") 1
          li.page-item
            a.page-link(href="#") 2
          li.page-item
            a.page-link(href="#") 3
          li.page-item.disabled
            span.page-link ...
          li.page-item
            a.page-link(href="#") 7
          li.page-item
            a.page-link(href="#" aria-label="Next")
              i.bi.bi-chevron-right.small
          li.page-item
            a.page-link.text-uppercase.small.fw-bold(href="#" aria-label="Last")
              i.bi.bi-chevron-double-right.small
