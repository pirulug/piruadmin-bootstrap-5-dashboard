extends ../../layouts/dashboard

block config
  - pageName = "Colors"
  - pageUrl = "pages/colors"

block content
  .mb-3
    h1.h3.d-inline.align-middle Color System
    span.badge.bg-primary.ms-2.align-middle Theme Palette

  p.text-body-secondary
    | Discover the visual identity of PiruAdmin. This color system is built with Bootstrap 5 theme variables and utility classes, supporting light and dark modes natively.

  .row
    .col-12.col-lg-6
      .card.mb-4
        .card-header
          h5.card-title.mb-0 Theme Colors
          p.card-subtitle.text-body-secondary.small.mb-0 Brand colors representing actions, status, and feedback.
        .card-body
          .row.g-3
            .col-12.col-sm-6
              .p-3.rounded.border.bg-primary.text-white.d-flex.flex-column.justify-content-between(style="height: 100px;")
                span.fw-bold.small Primary
                .d-flex.justify-content-between.align-items-end.small
                  code.text-white .bg-primary
                  span $primary
            .col-12.col-sm-6
              .p-3.rounded.border.bg-secondary.text-white.d-flex.flex-column.justify-content-between(style="height: 100px;")
                span.fw-bold.small Secondary
                .d-flex.justify-content-between.align-items-end.small
                  code.text-white .bg-secondary
                  span $secondary
            .col-12.col-sm-6
              .p-3.rounded.border.bg-success.text-white.d-flex.flex-column.justify-content-between(style="height: 100px;")
                span.fw-bold.small Success
                .d-flex.justify-content-between.align-items-end.small
                  code.text-white .bg-success
                  span $success
            .col-12.col-sm-6
              .p-3.rounded.border.bg-info.text-white.d-flex.flex-column.justify-content-between(style="height: 100px;")
                span.fw-bold.small Info
                .d-flex.justify-content-between.align-items-end.small
                  code.text-white .bg-info
                  span $info
            .col-12.col-sm-6
              .p-3.rounded.border.bg-warning.text-dark.d-flex.flex-column.justify-content-between(style="height: 100px;")
                span.fw-bold.small Warning
                .d-flex.justify-content-between.align-items-end.small
                  code.text-dark .bg-warning
                  span $warning
            .col-12.col-sm-6
              .p-3.rounded.border.bg-danger.text-white.d-flex.flex-column.justify-content-between(style="height: 100px;")
                span.fw-bold.small Danger
                .d-flex.justify-content-between.align-items-end.small
                  code.text-white .bg-danger
                  span $danger

    .col-12.col-lg-6
      .card.mb-4
        .card-header
          h5.card-title.mb-0 Theme Color Tints (Subtle Tones)
          p.card-subtitle.text-body-secondary.small.mb-0 Transparent primary brand-aware tints for high-end active statuses and backgrounds.
        .card-body
          .row.g-3
            .col-12.col-sm-6
              .p-3.rounded.border.d-flex.flex-column.justify-content-between(style="height: 100px; background: rgba(var(--pr-primary-rgb), 0.05); color: var(--pr-primary);")
                span.fw-bold.small Primary Hover (5%)
                .d-flex.justify-content-between.align-items-end.small
                  code.small rgba($primary, 0.05)
                  span Submenu Hover
            .col-12.col-sm-6
              .p-3.rounded.border.d-flex.flex-column.justify-content-between(style="height: 100px; background: rgba(var(--pr-primary-rgb), 0.1); color: var(--pr-primary);")
                span.fw-bold.small Primary Active (10%)
                .d-flex.justify-content-between.align-items-end.small
                  code.small rgba($primary, 0.1)
                  span Submenu Active
            .col-12.col-sm-6
              .p-3.rounded.border.d-flex.flex-column.justify-content-between(style="height: 100px; background: rgba(var(--pr-primary-rgb), 0.25); color: var(--pr-primary);")
                span.fw-bold.small Primary Border (25%)
                .d-flex.justify-content-between.align-items-end.small
                  code.small rgba($primary, 0.25)
                  span Sidebar Guide Line
            .col-12.col-sm-6
              .p-3.rounded.border.bg-body-secondary.text-body.d-flex.flex-column.justify-content-between(style="height: 100px;")
                span.fw-bold.small Body Secondary
                .d-flex.justify-content-between.align-items-end.small
                  code.text-body .bg-body-secondary
                  span Theme Backgrounds

  .row
    .col-12
      .card
        .card-header
          h5.card-title.mb-0 Grayscale & Body Colors
          p.card-subtitle.text-body-secondary.small.mb-0 Neutral colors that dynamically change to guarantee contrast under Dark Mode.
        .card-body
          .row.g-3
            .col-12.col-sm-4.col-md-3
              .p-3.rounded.border.bg-body.text-body.d-flex.flex-column.justify-content-between(style="height: 90px;")
                span.fw-semibold.small Body Background
                code.small .bg-body
            .col-12.col-sm-4.col-md-3
              .p-3.rounded.border.bg-body-tertiary.text-body.d-flex.flex-column.justify-content-between(style="height: 90px;")
                span.fw-semibold.small Body Tertiary
                code.small .bg-body-tertiary
            .col-12.col-sm-4.col-md-3
              .p-3.rounded.border.text-body.d-flex.flex-column.justify-content-between(style="height: 90px; background: var(--pr-card-bg);")
                span.fw-semibold.small Card Background
                code.small var(--pr-card-bg)
            .col-12.col-sm-4.col-md-3
              .p-3.rounded.border.bg-dark.text-white.d-flex.flex-column.justify-content-between(style="height: 90px;")
                span.fw-semibold.small Solid Dark
                code.small .bg-dark

  .row.mt-4
    .col-12
      .card
        .card-header
          h5.card-title.mb-0 Social & Brand Colors Showcase
          p.card-subtitle.text-body-secondary.small.mb-0 Unified brand colors for social sign-in buttons, sharing actions, and custom avatar profiles.
        .card-body
          .row.g-3
            // Brand: Facebook
            .col-12.col-sm-6.col-md-4.col-xl-3
              .p-3.rounded.border.d-flex.flex-column.gap-2
                .d-flex.align-items-center.justify-content-between.mb-1
                  .d-flex.align-items-center.gap-2
                    .avatar.avatar-sm.avatar-facebook
                      i.bi.bi-facebook
                    span.fw-bold.small Facebook
                  span.text-body-secondary.small.font-monospace #1877f2
                .d-flex.gap-2
                  button.btn.btn-sm.btn-facebook.w-50 Solid
                  button.btn.btn-sm.btn-outline-facebook.w-50 Outline

