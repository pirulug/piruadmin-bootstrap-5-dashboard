block scripts
  script(src="https://cdn.jsdelivr.net/gh/mdbassit/Wysi@latest/dist/wysi.min.js" crossorigin="anonymous")
  script.
    document.addEventListener("DOMContentLoaded", function() {
      if (typeof Wysi === 'undefined') {
        console.error("Wysi editor could not be loaded.");
        return;
      }

      const isDark = document.documentElement.getAttribute("data-bs-theme") === "dark";

      const editor = Wysi({
        el: '#my-editor',
        darkMode: isDark,
        height: 400,
        autoGrow: true,
        tools: [
          'format', '|', 
          'bold', 'italic', 'underline', 'strike', '|', 
          { label: 'Alignment', items: ['alignLeft', 'alignCenter', 'alignRight', 'alignJustify'] }, '|', 
          'ul', 'ol', '|', 
          'link', 'image', 'hr', 'quote', '|', 
          'removeFormat'
        ]
      });

      document.getElementById("save-content").addEventListener("click", function() {
        const content = document.querySelector('#my-editor').value;
        console.log("Captured Content:", content);
        
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            title: 'Success!',
            text: 'Content saved successfully.',
            icon: 'success',
            confirmButtonColor: '#ff0055'
          });
        } else {
          alert("Content saved successfully! Check the console.");
        }
      });
    });
