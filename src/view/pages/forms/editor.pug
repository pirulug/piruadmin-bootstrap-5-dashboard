extends ../../layouts/dashboard

append config
  - pageName = "WYSIWYG Editor"
  - pageUrl = "forms/editor"

block styles
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/gh/mdbassit/Wysi@latest/dist/wysi.min.css" crossorigin="anonymous")
  style.
    /* Styling only the editor container and toolbar, preserving internal HTML styles */
    .wysi {
      border: 1px solid #dee2e6 !important;
      border-radius: 0.375rem !important;
      background-color: #ffffff !important;
      box-shadow: none !important;
    }
    .wysi-toolbar {
      background-color: #f8f9fa !important;
      border-bottom: 1px solid #dee2e6 !important;
    }
    .wysi-toolbar-group {
      border-right: 1px solid #dee2e6 !important;
    }
    .wysi-btn {
      color: #212529 !important;
    }
    .wysi-btn:hover {
      background-color: #e9ecef !important;
    }
    .wysi-content {
      padding: 1.5rem !important;
      min-height: 350px;
    }

    /* Dark Mode overrides */
    [data-bs-theme="dark"] .wysi {
      border-color: #333333 !important;
      background-color: #1a1a1a !important;
    }
    [data-bs-theme="dark"] .wysi-toolbar {
      background-color: #2a2a2a !important;
      border-color: #333333 !important;
    }
    [data-bs-theme="dark"] .wysi-toolbar-group {
      border-color: #333333 !important;
    }
    [data-bs-theme="dark"] .wysi-btn {
      color: #e0e0e0 !important;
    }
    [data-bs-theme="dark"] .wysi-btn:hover {
      background-color: #333333 !important;
    }

